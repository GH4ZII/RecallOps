# CockroachDB connection string (required for Phase 2+)
# Cloud example:
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:26257/defaultdb?sslmode=verify-full
# Local insecure example:
# DATABASE_URL=postgresql://root@localhost:26257/defaultdb?sslmode=disable
DATABASE_URL=

# Amazon Bedrock embeddings (Phase 3+) — Titan Text Embeddings V2
# Enable model access for amazon.titan-embed-text-v2:0 in the Bedrock console.
AWS_REGION=
# AWS_DEFAULT_REGION=  # alternative to AWS_REGION
# Credentials: env keys below, or AWS shared config/profile / instance role
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_PROFILE=
# BEDROCK_EMBEDDING_MODEL=amazon.titan-embed-text-v2:0
